###############################################################################
# SENTINEL AI X — Environment Configuration
# Copy to .env and fill in your values
###############################################################################

# ─────────────────────── Application ────────────────────────────────
APP_NAME=sentinel-ai-x
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO
SECRET_KEY=change-me-to-a-random-64-char-string

# ─────────────────────── NVIDIA Build API ───────────────────────────
NVIDIA_API_KEY=nvapi-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Model assignments (override defaults)
NVIDIA_REASONING_MODEL=nvidia/llama-3.3-nemotron-super-49b-v1
NVIDIA_CODE_MODEL=nvidia/llama-3.1-nemotron-70b-instruct
NVIDIA_LIGHTWEIGHT_MODEL=nvidia/llama-3.3-nemotron-nano-8b-v1
NVIDIA_EMBEDDING_MODEL=nvidia/nv-embedqa-e5-v5
NVIDIA_RERANK_MODEL=nvidia/llama-nemotron-rerank-v2
NVIDIA_VISION_MODEL=nvidia/llama-nemotron-nano-vl-8b-v1
NVIDIA_SAFETY_MODEL=nvidia/llama-guard-3-8b

# ─────────────────────── PostgreSQL ─────────────────────────────────
POSTGRES_DB=sentinel
POSTGRES_USER=sentinel
POSTGRES_PASSWORD=sentinel_secret
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://sentinel:sentinel_secret@localhost:5432/sentinel

# ─────────────────────── Redis ──────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
REDIS_PORT=6379

# ─────────────────────── Neo4j ──────────────────────────────────────
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=sentinel_graph
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687

# ─────────────────────── Qdrant ─────────────────────────────────────
QDRANT_URL=http://localhost:6333
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334

# ─────────────────────── GitHub ─────────────────────────────────────
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_PRIVATE_KEY_PATH=./github-app-key.pem
GITHUB_WEBHOOK_SECRET=change-me-webhook-secret
GITHUB_API_URL=https://api.github.com

# Alternative: Personal Access Token (for development)
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─────────────────────── Frontend ───────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=change-me-nextauth-secret
GITHUB_ID=
GITHUB_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FRONTEND_PORT=3000
BACKEND_PORT=8000

# ─────────────────────── JWT Auth ───────────────────────────────────
JWT_SECRET_KEY=change-me-jwt-secret-key
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=1440

# ─────────────────────── Celery ─────────────────────────────────────
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
